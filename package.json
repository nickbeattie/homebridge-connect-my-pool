{
  "name": "@nickbeattie/homebridge-connect-my-pool",
  "displayName": "Homebridge ConnectMyPool",
  "version": "0.1.0",
  "description": "Homebridge 2 integration for AstralPool ConnectMyPool systems.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickbeattie/homebridge-connect-my-pool.git"
  },
  "homepage": "https://github.com/nickbeattie/homebridge-connect-my-pool#readme",
  "bugs": {
    "url": "https://github.com/nickbeattie/homebridge-connect-my-pool/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^2.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "pool",
    "astralpool",
    "connectmypool"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "package:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.1.9",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "homebridge": "^2.2.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
