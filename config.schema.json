{
  "pluginAlias": "ConnectMyPool",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "pools"
    ],
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "ConnectMyPool"
      },
      "pollIntervalSeconds": {
        "title": "Status Poll Interval",
        "description": "Seconds between pool status requests. ConnectMyPool permits no less than 60 seconds.",
        "type": "integer",
        "minimum": 60,
        "maximum": 3600,
        "default": 60
      },
      "pools": {
        "title": "Pools",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "poolApiCode"
          ],
          "properties": {
            "id": {
              "title": "Stable ID",
              "description": "A permanent lowercase identifier used to keep HomeKit accessory identities stable.",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
              "placeholder": "backyard"
            },
            "name": {
              "title": "Pool Name",
              "type": "string",
              "placeholder": "Backyard Pool"
            },
            "poolApiCode": {
              "title": "Pool API Code",
              "description": "The Home Automation API code shown in ConnectMyPool.",
              "type": "string",
              "format": "password"
            },
            "expose": {
              "title": "Accessories",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "heaters": {
                  "title": "Heaters",
                  "type": "boolean",
                  "default": true
                },
                "solar": {
                  "title": "Solar Systems",
                  "type": "boolean",
                  "default": true
                },
                "channels": {
                  "title": "Channel Cycle Controls",
                  "type": "boolean",
                  "default": true
                },
                "valves": {
                  "title": "Valves",
                  "type": "boolean",
                  "default": true
                },
                "lighting": {
                  "title": "Lighting Zones",
                  "type": "boolean",
                  "default": true
                },
                "favourites": {
                  "title": "Favourites",
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        }
      }
    }
  }
}
